# Copy to `.env` and fill in from the Firebase console.
# Project settings -> General -> Your apps -> Web app -> SDK setup and configuration
VITE_FB_API_KEY=
VITE_FB_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FB_PROJECT_ID=your-project
VITE_FB_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FB_MSG_SENDER_ID=
VITE_FB_APP_ID=

# Project settings -> Cloud Messaging -> Web Push certificates -> "Key pair"
VITE_FB_VAPID_KEY=

# Any shared string. Both of you must use the identical value.
VITE_PAIRING_ID=twofold
