rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function member(pairingId) {
      return signedIn()
        && request.auth.uid in get(/databases/$(database)/documents/pairings/$(pairingId)).data.members;
    }

    match /users/{userId} {
      allow read, create, update: if signedIn() && request.auth.uid == userId;
      allow delete: if false;
    }

    // A random invitation URL names this document. It admits one signed-in
    // person, then closes permanently when the second member joins.
    match /pairings/{pairingId} {
      allow create: if signedIn()
                    && request.resource.data.members.size() == 1
                    && request.resource.data.members[0] == request.auth.uid;
      allow get: if signedIn()
                 && (request.auth.uid in resource.data.members
                     || resource.data.members.size() == 1);
      allow list: if false;
      allow update: if signedIn()
                    && request.auth.uid in resource.data.members
                    && request.resource.data.members == resource.data.members;
      allow delete: if false;
    }

    match /memories/{memoryId} {
      allow read: if member(resource.data.pairingId);

      allow create: if member(request.resource.data.pairingId)
                    && request.resource.data.senderId == request.auth.uid
                    && request.resource.data.isBurned == false;

      // Reactions, view receipts and burning. Authorship is frozen and a burn
      // can never be undone.
      allow update: if member(resource.data.pairingId)
                    && request.resource.data.diff(resource.data).affectedKeys()
                      .hasOnly(['receivedAt', 'viewedAt', 'reactions', 'isBurned', 'mediaUrl'])
                    && request.resource.data.pairingId == resource.data.pairingId
                    && request.resource.data.senderId == resource.data.senderId
                    && request.resource.data.type == resource.data.type
                    && (!request.resource.data.diff(resource.data).affectedKeys()
                          .hasAny(['receivedAt', 'viewedAt', 'isBurned', 'mediaUrl'])
                        || request.auth.uid != resource.data.senderId)
                    && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['receivedAt'])
                        || resource.data.get('receivedAt', null) == null)
                    && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['viewedAt'])
                        || resource.data.get('viewedAt', null) == null)
                    && !(resource.data.isBurned == true && request.resource.data.isBurned == false);

      allow delete: if false;

      // The body of a letter. This is what makes "open when" real rather than
      // cosmetic: until the clock passes unlockAt the server refuses to hand
      // the text over at all, so there is nothing on the device to peek at.
      match /secret/content {
        allow read: if member(get(/databases/$(database)/documents/memories/$(memoryId)).data.pairingId)
                    && (resource.data.unlockAt == null
                        || request.time >= resource.data.unlockAt);

        allow create: if member(getAfter(/databases/$(database)/documents/memories/$(memoryId)).data.pairingId);
        allow update, delete: if false;  // a sealed letter is not rewritten
      }
    }

    match /alerts/{alertId} {
      allow read: if member(resource.data.pairingId);
      allow create: if member(request.resource.data.pairingId)
                    && request.resource.data.from == request.auth.uid;
      allow update, delete: if false;
    }

    // Bouquets follow the same private, two-person delivery model as letters.
    // Their composition is immutable; only the recipient can add receipts.
    match /bouquets/{bouquetId} {
      allow read: if member(resource.data.pairingId);

      allow create: if member(request.resource.data.pairingId)
                    && request.resource.data.keys().hasOnly([
                      'version', 'pairingId', 'senderId', 'recipientId', 'title',
                      'itemCount', 'composition', 'createdAt', 'receivedAt', 'viewedAt'
                    ])
                    && request.resource.data.version == 1
                    && request.resource.data.senderId == request.auth.uid
                    && request.resource.data.recipientId != request.auth.uid
                    && request.resource.data.recipientId in get(/databases/$(database)/documents/pairings/$(request.resource.data.pairingId)).data.members
                    && request.resource.data.title is string
                    && request.resource.data.title.size() <= 80
                    && request.resource.data.itemCount >= 3
                    && request.resource.data.itemCount <= 30
                    && request.resource.data.composition is map
                    && request.resource.data.composition.version == 1
                    && request.resource.data.composition.items is list
                    && request.resource.data.composition.items.size() == request.resource.data.itemCount
                    && request.resource.data.composition.wrapId is string
                    && (request.resource.data.composition.ribbonId == null
                        || request.resource.data.composition.ribbonId is string)
                    && request.resource.data.composition.bouquetStyle in ['classic', 'meadow', 'tall']
                    && request.resource.data.composition.note is map
                    && request.resource.data.composition.note.to is string
                    && request.resource.data.composition.note.to.size() >= 1
                    && request.resource.data.composition.note.to.size() <= 60
                    && request.resource.data.composition.note.body is string
                    && request.resource.data.composition.note.body.size() >= 1
                    && request.resource.data.composition.note.body.size() <= 500
                    && request.resource.data.composition.note.from is string
                    && request.resource.data.composition.note.from.size() >= 1
                    && request.resource.data.composition.note.from.size() <= 60
                    && request.resource.data.receivedAt == null
                    && request.resource.data.viewedAt == null;

      allow update: if member(resource.data.pairingId)
                    && (request.resource.data == resource.data
                        || (request.auth.uid == resource.data.recipientId
                            && request.resource.data.diff(resource.data).affectedKeys()
                              .hasOnly(['receivedAt', 'viewedAt'])
                            && request.resource.data.pairingId == resource.data.pairingId
                            && request.resource.data.senderId == resource.data.senderId
                            && request.resource.data.recipientId == resource.data.recipientId
                            && request.resource.data.composition == resource.data.composition
                            && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['receivedAt'])
                                || resource.data.get('receivedAt', null) == null)
                            && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['viewedAt'])
                                || resource.data.get('viewedAt', null) == null)));

      allow delete: if false;
    }

    // Device push tokens. Only the server-side Admin SDK can read these.
    match /tokens/{token} {
      allow read: if false;
      allow create: if signedIn()
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.token == token;
      allow update: if signedIn()
                    && resource.data.uid == request.auth.uid
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.token == token;
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
