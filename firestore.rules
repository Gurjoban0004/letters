rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function member(pairingId) {
      return signedIn()
        && request.auth.uid in get(/databases/$(database)/documents/pairings/$(pairingId)).data.members;
    }

    match /users/{userId} {
      allow read, create, update: if signedIn() && request.auth.uid == userId;
      allow delete: if false;
    }

    // A random invitation URL names this document. It admits one signed-in
    // person, then closes permanently when the second member joins.
    match /pairings/{pairingId} {
      allow create: if signedIn()
                    && request.resource.data.members.size() == 1
                    && request.resource.data.members[0] == request.auth.uid;
      allow get: if signedIn()
                 && (request.auth.uid in resource.data.members
                     || resource.data.members.size() == 1);
      allow list: if false;
      allow update: if signedIn()
                    && request.auth.uid in resource.data.members
                    && request.resource.data.members == resource.data.members;
      allow delete: if false;
    }

    match /memories/{memoryId} {
      allow read: if member(resource.data.pairingId);

      allow create: if member(request.resource.data.pairingId)
                    && request.resource.data.senderId == request.auth.uid
                    && request.resource.data.isBurned == false;

      // Reactions, view receipts and burning. Authorship is frozen and a burn
      // can never be undone.
      allow update: if member(resource.data.pairingId)
                    && request.resource.data.diff(resource.data).affectedKeys()
                      .hasOnly(['receivedAt', 'viewedAt', 'reactions', 'isBurned', 'mediaUrl'])
                    && request.resource.data.pairingId == resource.data.pairingId
                    && request.resource.data.senderId == resource.data.senderId
                    && request.resource.data.type == resource.data.type
                    && (!request.resource.data.diff(resource.data).affectedKeys()
                          .hasAny(['receivedAt', 'viewedAt', 'isBurned', 'mediaUrl'])
                        || request.auth.uid != resource.data.senderId)
                    && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['receivedAt'])
                        || resource.data.get('receivedAt', null) == null)
                    && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['viewedAt'])
                        || resource.data.get('viewedAt', null) == null)
                    && !(resource.data.isBurned == true && request.resource.data.isBurned == false);

      allow delete: if false;

      // The body of a letter. This is what makes "open when" real rather than
      // cosmetic: until the clock passes unlockAt the server refuses to hand
      // the text over at all, so there is nothing on the device to peek at.
      match /secret/content {
        allow read: if member(get(/databases/$(database)/documents/memories/$(memoryId)).data.pairingId)
                    && (resource.data.unlockAt == null
                        || request.time >= resource.data.unlockAt);

        allow create: if member(getAfter(/databases/$(database)/documents/memories/$(memoryId)).data.pairingId);
        allow update, delete: if false;  // a sealed letter is not rewritten
      }
    }

    match /alerts/{alertId} {
      allow read: if member(resource.data.pairingId);
      allow create: if member(request.resource.data.pairingId)
                    && request.resource.data.from == request.auth.uid;
      allow update, delete: if false;
    }

    // Device push tokens. Only the server-side Admin SDK can read these.
    match /tokens/{token} {
      allow read: if false;
      allow create: if signedIn()
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.token == token;
      allow update: if signedIn()
                    && resource.data.uid == request.auth.uid
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.token == token;
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
